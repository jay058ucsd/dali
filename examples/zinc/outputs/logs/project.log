import pandas as pd

df = pd.DataFrame(data)

zinc_values = []
food_groups = []

for item in data:
    food_groups.append(item['group'])
    for nutrient in item['nutrients']:
        if nutrient['description'] == 'Zinc, Zn':
            zinc_values.append(nutrient['value'])
            break
    else:
        zinc_values.append(None)

